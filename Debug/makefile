	@echo 'Building target: $@'
	@echo 'Invoking: C2000 Linker'
	@echo 'Flags: -v28 -ml -mt --float_support=fpu32 --define=CPU1 --define=_FLASH -g --diag_warning=225 --diag_wrap=off --display_error_number -z -m"VCU_TEST.map" --heap_size=0x2000 --stack_size=0x2000 --warn_sections -i"C:/ti/ccs1230/ccs/tools/compiler/ti-cgt-c2000_22.6.0.LTS/lib" -i"D:/git repositories/p.kmc_vcu_ep_unit_test/subm_vcu_ep/SourceCode/FlashAPI" -i"C:/ti/ccs1230/ccs/tools/compiler/ti-cgt-c2000_22.6.0.LTS/include" --reread_libs --diag_wrap=off --display_error_number --xml_link_info="VCU_TEST_linkInfo.xml" --rom_model'
	$(shell echo -v28 -ml -mt --float_support=fpu32 --define=CPU1 --define=_FLASH -g --diag_warning=225 --diag_wrap=off --display_error_number -z -m"VCU_TEST.map" --heap_size=0x2000 --stack_size=0x2000 --warn_sections -i"C:/ti/ccs1230/ccs/tools/compiler/ti-cgt-c2000_22.6.0.LTS/lib" -i"D:/git repositories/p.kmc_vcu_ep_unit_test/subm_vcu_ep/SourceCode/FlashAPI" -i"C:/ti/ccs1230/ccs/tools/compiler/ti-cgt-c2000_22.6.0.LTS/include" --reread_libs --diag_wrap=off --display_error_number --xml_link_info="VCU_TEST_linkInfo.xml" --rom_model > "ccsLinker.opt")
	$(shell type "ccsObjs.opt" >> "ccsLinker.opt")
	"C:/ti/ccs1230/ccs/tools/compiler/ti-cgt-c2000_22.6.0.LTS/bin/cl2000" -@"ccsLinker.opt" -o "VCU_TEST.out"
	@echo 'Finished building target: $@'
	@echo ' '

